{% extends "portada.twig" %}

{% block contenido_principal %}
<link rel="stylesheet" href="css/acceso.css"> 

<div class="auth-wrapper">
    <div class="auth-card">
        <h2>Panel de Control</h2>
        
        <p>Bienvenido, <strong>{{ session.user }}</strong></p>
        <span class="user-role">{{ session.rol }}</span>

        <div class="panel-links">
            <ul>
                {% if session.rol in ['gestor', 'administrador'] %}
                    <li><a href="gestion_noticia.php">📰 Gestionar Noticias</a></li>
                {% endif %}
                
                {% if session.rol in ['moderador', 'administrador'] %}
                    <li><a href="gestion_comentarios.php">💬 Moderar Comentarios</a></li>
                {% endif %}
                
                <li><a href="perfil.php">👤 Mi Perfil</a></li>
                
                {% if session.rol == 'administrador' %}
                    <li><a href="gestion_usuarios.php">👥 Gestionar Usuarios</a></li>
                {% endif %}
            </ul>
        </div>

        <div class="logout-box-bordered">
            <a href="logout.php" class="link-danger">Cerrar Sesión</a>
        </div>
    </div>
</div>
{% endblock %}