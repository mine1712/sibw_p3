<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Incidencias Peligros</title>
    <link rel="stylesheet" href="/css/portada_noticia.css">
</head>
<body>
    <header>
        <div class="logo">
            <a href="portada.php">
                <img src="img/logo.png" alt="Logo">
            </a>
        </div>
        <div class="nombre">
            <h1>Incidencias en Peligros</h1>
        </div>
        <nav class="enlaces">
            {% if session.login %}
                {# El nombre ahora es un enlace directo a la edición de perfil #}
                <a href="perfil.php" title="Editar mi perfil" style="text-decoration:none;">
                    <span style="color:#2c3e50; font-size:14px; font-weight:600;">👤 {{ session.user }}</span>
                </a>
                <a href="logout.php">Cerrar sesión</a>
            {% else %}
                <a href="login.php?modo=login">Iniciar sesión</a>
                <a href="login.php?modo=registro">Registrarse</a>
            {% endif %}
            <a href="https://www.granada.org/inet/wambiente.nsf/directorio">Concejalía MedioAmbiente</a>
            <a href="https://www.granada.org/">Ayuntamiento de Granada</a>
            <a href="https://www.juntadeandalucia.es/">Junta de Andalucía</a>
        </nav>
    </header>

    <aside class="aside-izquierda">
        <ul>
            <li><a href="portada.php">Inicio</a></li>

            {% if session.login %}
                {# --- SECCIÓN MI PERFIL: Acceso a edición y baja --- #}
                <li><a href="perfil.php" style="font-weight:bold; color:#3498db;">👤 Mi Perfil</a></li>

                {# --- PANEL GENERAL (Noticias/Dashboard) --- #}
                <li><a href="acceso.php">Panel de Gestión</a></li>

                {# --- GESTIÓN DE NOTICIAS (Solo Gestores y Administradores) --- #}
                {% if session.rol == 'gestor' or session.rol == 'administrador' %}
                    <li><a href="gestion_noticia.php">Gestión Noticias</a></li>
                {% endif %}

                {# --- MODERACIÓN DE COMENTARIOS (Solo Moderadores y Administradores) --- #}
                {% if session.rol == 'moderador' or session.rol == 'administrador' %}
                    <li><a href="gestion_comentarios.php">Moderar Comentarios</a></li>
                {% endif %}

                {# --- GESTIÓN DE USUARIOS (Solo Administradores) --- #}
                {% if session.rol == 'administrador' %}
                    <li><a href="gestion_usuarios.php">Gestión Usuarios</a></li>
                {% endif %}

                <li><a href="logout.php">Cerrar sesión</a></li>

            {% else %}
                <li><a href="login.php?modo=login">Iniciar sesión</a></li>
                <li><a href="login.php?modo=registro">Registrarse</a></li>
            {% endif %}
        </ul>
    </aside>

    {% block contenido_principal %}
        <main class="contenedor-noticias" id="noticias-container">
            {% for n in noticias %}
                <article class="noticia">
                    <a href="noticia.php?id={{ n.id }}" style="text-decoration:none;">
                        <img src="img/{{ n.imagen_principal }}" alt="{{ n.titulo }}">
                        <h3>{{ n.titulo }}</h3>
                    </a>
                </article>
            {% endfor %}
        </main>
    {% endblock %}

    <footer>
        <div class="footer-arriba">
            <div class="id">Identificación</div>
            <div class="web">
                <a href="https://ayuntamientopeligros.es/">Web Ayuntamiento</a>
            </div>
            <div class="aviso-legal">Aviso legal</div>
        </div>
        <div class="footer-abajo">
            <p>&copy; Copyright 2026 </p>
        </div>
    </footer>

    
   {% block scripts %}{% endblock %}

</body>
</html>