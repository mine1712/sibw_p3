{% extends "portada.twig" %}

{% block contenido_principal %}
<div class="panel-usuarios">
    <h2>Mi Panel de Control</h2>

    {% if mensaje %}
        <div class="alerta-exito">{{ mensaje }}</div>
    {% endif %}

    <div class="grid-gestion">
        
        {# --- 1. SECCIÓN DE EDICIÓN DE DATOS PERSONALES --- #}
        {# Requisito: Cualquier usuario registrado puede cambiar sus datos #}
        <section class="card-gestion">
            <h3>👤 Mis Datos Personales</h3>
            <form action="perfil.php" method="POST" class="form-perfil">
                <input type="hidden" name="accion" value="actualizar_perfil">
                
                <div class="campo">
                    <label>Email:</label>
                    <input type="email" name="email" value="{{ user_data.email }}" required>
                </div>
                
                <div class="campo">
                    <label>Nueva Contraseña (opcional):</label>
                    <input type="password" name="password" placeholder="Mínimo 8 caracteres">
                    <small>Déjalo vacío para mantener la actual (se guardará codificada).</small>
                </div>
                
                <button type="submit" class="btn-guardar">Actualizar Perfil</button>
            </form>

            <hr>

            {# Requisito: Un usuario podrá eliminarse a sí mismo #}
            <form action="perfil.php" method="POST" onsubmit="return confirm('¿Estás seguro? Esta acción es irreversible.')">
                <input type="hidden" name="accion" value="auto_eliminar">
                <button type="submit" class="btn-peligro-link">Darse de baja del sistema</button>
            </form>
        </section>

        {# --- 2. SECCIÓN DE GESTIÓN DE NOTICIAS --- #}
        {# Solo para Gestor y Superusuario #}
        {% if session.rol in ['gestor', 'superusuario'] %}
        <section class="card-gestion">
            <h3>📰 Gestión de Noticias</h3>
            
            <form action="perfil.php" method="GET" class="buscador">
                <input type="text" name="q" value="{{ q }}" placeholder="Buscar por título o descripción...">
                <button type="submit">🔍</button>
            </form>

            <table class="tabla-mini">
                <thead>
                    <tr>
                        <th>Título</th>
                        <th>Fecha</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    {% for n in noticias %}
                    <tr>
                        <td>{{ n.titulo }}</td>
                        <td>{{ n.fecha }}</td>
                        <td>
                            <form action="usuarios.php" method="POST" onsubmit="return confirm('¿Borrar noticia?')">
                                <input type="hidden" name="accion" value="borrar_noticia">
                                <input type="hidden" name="id_noticia" value="{{ n.id }}">
                                <button type="submit" class="btn-icono">🗑️</button>
                            </form>
                        </td>
                    </tr>
                    {% else %}
                        <tr><td colspan="3">No se han encontrado noticias.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </section>
        {% endif %}

    </div>

    {# --- 3. SECCIÓN DE ADMINISTRACIÓN DE USUARIOS --- #}
    {# Exclusivo para Superusuario #}
    {% if session.rol == 'superusuario' %}
    <section class="card-gestion full-width">
        <h3>👥 Panel de Superusuario: Lista de Usuarios</h3>
        <table class="tabla-gestion">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Email</th>
                    <th>Rol actual</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                {% for u in usuarios %}
                <tr>
                    <td>{{ u.id }}</td>
                    <td>{{ u.email }}</td>
                    <td>
                        <form action="perfil.php" method="POST">
                            <input type="hidden" name="id_usuario" value="{{ u.id }}">
                            <select name="nuevo_rol" onchange="this.form.submit()" {{ u.id == session.id_user ? 'disabled' : '' }}>
                                {% for rol in roles_disponibles %}
                                    <option value="{{ rol }}" {{ u.rol == rol ? 'selected' : '' }}>{{ rol|capitalize }}</option>
                                {% endfor %}
                            </select>
                        </form>
                    </td>
                    <td>
                        {% if u.id != session.id_user %}
                        <form action="perfil.php" method="POST" onsubmit="return confirm('¿Eliminar permanentemente a este usuario?')">
                            <input type="hidden" name="accion" value="borrar_usuario">
                            <input type="hidden" name="id_usuario" value="{{ u.id }}">
                            <button type="submit" class="btn-borrar">Eliminar</button>
                        </form>
                        {% else %}
                            <span class="badge-yo">Tú</span>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </section>
    {% endif %}

    <div class="logout-link">
        <a href="logout.php">Cerrar sesión segura</a>
    </div>
</div>

<style>
    /* Estilos rápidos para que se vea bien el panel */
    .panel-usuarios { max-width: 1100px; margin: auto; padding: 20px; }
    .grid-gestion { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px; }
    .card-gestion { background: #f9f9f9; padding: 20px; border-radius: 8px; border: 1px solid #ddd; }
    .full-width { grid-column: 1 / -1; }
    .campo { margin-bottom: 15px; }
    .campo label { display: block; font-weight: bold; margin-bottom: 5px; }
    .campo input { width: 100%; padding: 8px; box-sizing: border-box; }
    .tabla-gestion, .tabla-mini { width: 100%; border-collapse: collapse; margin-top: 10px; }
    .tabla-gestion th, .tabla-gestion td, .tabla-mini td { padding: 10px; border-bottom: 1px solid #eee; text-align: left; }
    .btn-guardar { background: #2c3e50; color: white; padding: 10px 15px; border: none; cursor: pointer; border-radius: 4px; }
    .btn-peligro-link { background: none; border: none; color: #e74c3c; cursor: pointer; text-decoration: underline; padding: 0; }
    .badge-yo { color: #27ae60; font-weight: bold; font-size: 0.9em; }
    .alerta-exito { background: #d4edda; color: #155724; padding: 15px; border-radius: 4px; margin-bottom: 20px; border: 1px solid #c3e6cb; }
    
    @media (max-width: 768px) { .grid-gestion { grid-template-columns: 1fr; } }
</style>
{% endblock %}