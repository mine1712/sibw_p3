{% extends "portada.twig" %}

{% block contenido_principal %}
<!-- Vinculamos el archivo CSS externo que acabamos de crear -->
<link rel="stylesheet" href="css/gestion_noticia.css">

<div class="form-container">

    {# ================= BLOQUE 1: BUSCADOR (ARRIBA DEL TODO) ================= #}
    <div class="form-section">
        <h3>Filtro de Búsqueda</h3>
        <form action="gestion_noticia.php" method="GET" class="search-box">
            <select name="campo">
                <option value="titulo" {{ campo == 'titulo' ? 'selected' : '' }}>Título</option>
                <option value="descripcion" {{ campo == 'descripcion' ? 'selected' : '' }}>Descripción</option>
                <option value="hashtag" {{ campo == 'hashtag' ? 'selected' : '' }}>Hashtag</option>
            </select>
            <input type="text" name="q" value="{{ busqueda }}" placeholder="Escribe tu término de búsqueda...">
            <button type="submit">Filtrar</button>
            {% if busqueda %}
                <a href="gestion_noticia.php" class="search-clear-link">Mostrar todas</a>
            {% endif %}
        </form>
    </div>

    {# ================= BLOQUE 2: RESULTADOS Y LISTADO GENERAL ================= #}
    <div class="form-section">
        <h3>Listado de Incidencias Disponibles</h3>
        {% if noticias is not empty %}
            <table class="table-noticias">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Título</th>
                        <th>Fecha</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {% for n in noticias %}
                    <tr class="{{ noticia.id == n.id ? 'active-row' : '' }}">
                        <td>{{ n.id }}</td>
                        <td><strong>{{ n.titulo }}</strong></td>
                        <td>{{ n.fecha|date('d/m/Y H:i') }}</td>
                        <td>
                            <a href="gestion_noticia.php?id={{ n.id }}#formulario" class="action-btn btn-edit"> Editar</a>
                            <a href="gestion_noticia.php?accion=borrar&id={{ n.id }}" class="action-btn btn-delete" onclick="return confirm('¿Eliminar por completo esta incidencia?')"> Eliminar</a>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p class="no-results">No hay ninguna noticia que coincida con la búsqueda.</p>
        {% endif %}
    </div>

    {# ================= BLOQUE 3: FORMULARIO PRINCIPAL (ABAJO DEL TODO) ================= #}
    <div id="formulario" class="form-section {{ noticia.id ? 'editing-mode' : '' }}">
        <h3>{{ noticia.id ? 'Modificando Noticia (ID: ' ~ noticia.id ~ ')' : ' Añadir Nueva Noticia al Sistema' }}</h3>
        
        <form action="gestion_noticia.php" method="POST">
            <input type="hidden" name="id" value="{{ noticia.id }}">

            {# --- DATOS GENERALES --- #}
            <label>Título</label>
            <input type="text" name="titulo" value="{{ noticia.titulo }}" class="full-width" required>

            <div class="grid-fields-3 mt-15">
                <div>
                    <label>Fecha y Hora</label>
                    <input type="datetime-local" name="fecha" value="{{ noticia.fecha ? noticia.fecha|date('Y-m-d\\TH:i') : '' }}" class="full-width">
                </div>
                <div>
                    <label>Tipo</label>
                    <input type="text" name="tipo" value="{{ noticia.tipo }}" class="full-width">
                </div>
                <div>
                    <label>Gravedad</label>
                    <select name="gravedad" class="full-width">
                        <option value="Leve" {{ noticia.gravedad == 'Leve' ? 'selected' : '' }}>Leve</option>
                        <option value="Normal" {{ noticia.gravedad == 'Normal' ? 'selected' : '' }}>Normal</option>
                        <option value="Grave" {{ noticia.gravedad == 'Grave' ? 'selected' : '' }}>Grave</option>
                        <option value="Crítico" {{ noticia.gravedad == 'Crítico' ? 'selected' : '' }}>Crítico</option>
                    </select>
                </div>
            </div>

            <div class="grid-fields">
                <div>
                    <label>Concejalía</label>
                    <input type="text" name="concejalia" value="{{ noticia.concejalia }}" class="full-width">
                </div>
                <div>
                    <label>ID Lugar</label>
                    <input type="number" name="lugar_id" value="{{ noticia.lugar_id }}" class="full-width">
                </div>
            </div>

            <label>Personas Involucradas</label>
            <input type="text" name="personas" value="{{ noticia.personas }}" class="full-width mb-15">

            <label>Descripción</label>
            <textarea name="descripcion" rows="10" class="full-width">{{ noticia.descripcion }}</textarea>

            {# --- GESTIÓN DE HASHTAGS --- #}
            <div class="mt-20">
                <h3>Hashtags de la Noticia</h3>
                <div class="hashtags-info-box">
                    Escribe las etiquetas asociadas a esta noticia separadas por comas (por ejemplo: <i>incendios, vandalismo, bomberos</i>).
                </div>
                <label for="hashtags-input">Etiquetas (Tags)</label>
                <input type="text" id="hashtags-input" name="hashtags" value="{{ noticia.hashtags }}" class="full-width" placeholder="ejemplo1, ejemplo2, ejemplo3">
            </div>

            {# --- GALERÍA DE IMÁGENES --- #}
            <div class="mt-20">
                <h3>Gestión de Galería</h3>
                {% if imagenes is not empty %}
                    <div class="img-grid">
                        {% for img in imagenes %}
                        <div class="img-card {{ img.principal ? 'main' : '' }}">
                            <img src="img/{{ img.ruta_archivo }}">
                            <input type="text" name="desc_imgs[{{ img.id }}]" value="{{ img.descripcion_alt }}" placeholder="Texto ALT">
                            <div class="img-card-actions">
                                <a href="gestion_noticia.php?id={{ noticia.id }}&hacer_principal={{ img.id }}#formulario" title="Hacer Portada">⭐</a>
                                <a href="gestion_noticia.php?id={{ noticia.id }}&borrar_img={{ img.id }}#formulario" onclick="return confirm('¿Borrar esta imagen?')" title="Borrar">🗑️</a>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                {% endif %}
                
                <div class="mt-20">
                    <label for="nueva-imagen">Asociar archivo de imagen local (Nombre o ruta):</label>
                    <input type="text" id="nueva-imagen" name="nueva_imagen_ruta" class="full-width" placeholder="ejemplo: noticia_1_1.png">
                </div>
            </div>

            <div class="actions-container mt-20">
                {% if noticia.id %}
                    <a href="gestion_noticia.php" class="btn-cancel" Cancelar Edición</a>
                {% endif %}
                <button type="submit" class="btn-save">
                    {{ noticia.id ? 'Actualizar Registro' : 'Crear Noticia' }}
                </button>
            </div>
        </form>
    </div>

</div>
{% endblock %}