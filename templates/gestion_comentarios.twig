{% extends "portada.twig" %}

{% block contenido_principal %}
<link rel="stylesheet" href="css/acceso.css">
<link rel="stylesheet" href="css/gestion_comentarios.css">

<div class="auth-wrapper">
    <div class="auth-card wide">
        <h2>Moderación de Comentarios</h2>

        {# formulario #}
        <div class="card-comentario-accion">
            <h3>➕ Añadir Comentario </h3>
            <form action="gestion_comentarios.php" method="POST">
                <input type="hidden" name="accion" value="insertar">
                
                <div class="form-group-comentario">
                    <label>Noticia Asociada:</label>
                    <select name="id_noticia" required>
                        <option value="">-- Seleccionar Noticia --</option>
                        {% for n in noticias_list %}
                            <option value="{{ n.id }}">{{ n.titulo }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="form-row-flex">
                    <div class="flex-item form-group-comentario">
                        <label>Nombre:</label>
                        <input type="text" name="nombre" required>
                    </div>
                    <div class="flex-item form-group-comentario">
                        <label>E-mail:</label>
                        <input type="email" name="email" required>
                    </div>
                </div>

                <div class="form-group-comentario">
                    <label>Comentario:</label>
                    <textarea name="texto" required></textarea>
                </div>

                <button type="submit" class="btn-insertar-comentario">Agregar Comentario</button>
            </form>
        </div>

        {% if comentario_editar %}
            <div class="card-comentario-edicion">
                <h3>Editando comentario de: {{ comentario_editar.nombre }}</h3>
                
                <form action="gestion_comentarios.php" method="POST">
                    <input type="hidden" name="id_edit" value="{{ comentario_editar.id }}">
                    
                    <div class="form-group-comentario">
                        <textarea name="texto" id="comentario-texto">{{ comentario_editar.texto }}</textarea>
                    </div>
                    
                    <div>
                        <button type="submit" class="btn-guardar-comentario">Guardar Cambios</button>
                        <a href="gestion_comentarios.php" class="btn-cancelar-comentario">Cancelar</a>
                    </div>
                </form>
            </div>
        {% endif %}

        <table class="data-table table-comentarios">
            <thead>
                <tr>
                    <th>Usuario</th>
                    <th>Comentario</th>
                    <th class="text-center-th">Acciones</th>
                </tr>
            </thead>
            <tbody>
                {% for c in comentarios %}
                <tr class="row-comentario">
                    <td class="user-meta-info">
                        <strong>{{ c.nombre }}</strong><br>
                        <small>{{ c.email }}</small><br>
                        <span class="news-origin">En: {{ c.noticia_titulo }}</span>
                    </td>
                    <td>{{ c.texto }}</td>
                    <td class="acciones-iconos text-center-td">
                        <a href="gestion_comentarios.php?accion=editar&id={{ c.id }}">✏️</a>
                        <a href="gestion_comentarios.php?accion=borrar&id={{ c.id }}" onclick="return confirm('¿Borrar?')">🗑️</a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>

        <div class="footer-navigation-panel">
            <a href="acceso.php">⬅ Volver al Menú</a>
        </div>
    </div>
</div>
{% endblock %}